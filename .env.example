PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trello_clone
# En producción (Neon), seteá DATABASE_URL en vez de los DB_* de arriba.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Carpeta donde se guardan los adjuntos (T8.3). Relativa al cwd de la API.
# ATTACHMENTS_DIR=uploads

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# URL(s) del frontend permitidas por CORS, separadas por coma. Vacío = sin
# restricción (default de desarrollo local).
# CORS_ORIGIN=https://tu-app.vercel.app
